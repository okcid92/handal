generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                     BigInt              @id @default(autoincrement())
  name                   String
  ine                    String?             @unique @db.VarChar(12)
  email                  String?             @unique
  password               String
  role                   Role                @default(STUDENT)
  department             String?
  emailVerifiedAt        DateTime?           @map("email_verified_at")
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")
  analysisHistory        AnalysisHistory[]
  appreciationsAsDa      FinalAppreciation[] @relation("AppreciationDa")
  appreciationsAsTeacher FinalAppreciation[] @relation("AppreciationTeacher")
  documentsOwned         Document[]          @relation("DocumentStudent")
  referenceDocuments     ReferenceDocument[] @relation("ReferenceUploadedBy")
  reportsGenerated       SimilarityReport[]
  themesOwned            Theme[]             @relation("StudentThemes")
  deliberations          Deliberation[]

  @@map("users")
}

model Theme {
  id              BigInt      @id @default(autoincrement())
  studentId       BigInt      @map("student_id")
  title           String      @db.VarChar(500)
  titleNormalized String?     @unique @map("title_normalized")
  description     String?     @db.Text
  status          ThemeStatus @default(PENDING)

  themeSimilarityScore Decimal? @map("theme_similarity_score") @db.Decimal(5, 2)
  themeSignature       String?  @map("theme_signature") @db.LongText

  teacherVote    String?   @map("teacher_vote")
  teacherComment String?   @map("teacher_comment") @db.Text
  teacherVotedAt DateTime? @map("teacher_voted_at")

  daVote    String?   @map("da_vote")
  daComment String?   @map("da_comment") @db.Text
  daVotedAt DateTime? @map("da_voted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  student   User       @relation("StudentThemes", fields: [studentId], references: [id], map: "themes_student_id_fkey")
  documents Document[]

  @@index([studentId])
  @@index([status])
  @@map("themes")
}

model Document {
  id                  BigInt             @id @default(autoincrement())
  themeId             BigInt?            @map("theme_id")
  studentId           BigInt             @map("student_id")
  originalName        String             @map("original_name")
  storagePath         String             @map("storage_path")
  mimeType            String             @map("mime_type")
  fileSize            BigInt             @map("file_size")
  checksum            String
  isFinal             Boolean            @default(true) @map("is_final")
  isReference         Boolean            @default(false) @map("is_reference")
  documentStatus      DocumentStatus     @default(SUBMITTED) @map("document_status")
  submittedAt         DateTime           @map("submitted_at")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  extractedText       String?            @map("extracted_text") @db.LongText
  analysisStatus      AnalysisStatus     @default(PENDING) @map("analysis_status")
  analysisQueuedAt    DateTime?          @map("analysis_queued_at")
  analysisStartedAt   DateTime?          @map("analysis_started_at")
  analysisCompletedAt DateTime?          @map("analysis_completed_at")
  analysisError       String?            @map("analysis_error") @db.Text
  uploadAttempts      Int                @default(1) @map("upload_attempts")
  stagingMetadata     String?            @map("staging_metadata") @db.LongText
  student             User               @relation("DocumentStudent", fields: [studentId], references: [id], map: "documents_student_id_fkey")
  theme               Theme?             @relation(fields: [themeId], references: [id], onDelete: Restrict, map: "documents_theme_id_fkey")
  appreciation        FinalAppreciation?
  reports             SimilarityReport[]

  @@index([themeId])
  @@index([studentId])
  @@index([isReference])
  @@map("documents")
}

model FinalAppreciation {
  id               BigInt                @id @default(autoincrement())
  documentId       BigInt                @unique @map("document_id")
  teacherId        BigInt?               @map("teacher_id")
  teacherDecision  AppreciationDecision? @map("teacher_decision")
  teacherComment   String?               @map("teacher_comment") @db.Text
  teacherDecidedAt DateTime?             @map("teacher_decided_at")
  daId             BigInt?               @map("da_id")
  daDecision       AppreciationDecision? @map("da_decision")
  daComment        String?               @map("da_comment") @db.Text
  daDecidedAt      DateTime?             @map("da_decided_at")
  finalDecision    AppreciationDecision? @map("final_decision")
  mention          String?               @db.VarChar(100)
  finalizedAt      DateTime?             @map("finalized_at")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  da               User?                 @relation("AppreciationDa", fields: [daId], references: [id], map: "final_appreciations_da_id_fkey")
  document         Document              @relation(fields: [documentId], references: [id], map: "final_appreciations_document_id_fkey")
  teacher          User?                 @relation("AppreciationTeacher", fields: [teacherId], references: [id], map: "final_appreciations_teacher_id_fkey")

  @@index([teacherId])
  @@index([daId])
  @@map("final_appreciations")
}

model ReferenceDocument {
  id            BigInt   @id @default(autoincrement())
  uploadedBy    BigInt   @map("uploaded_by")
  originalName  String   @map("original_name")
  mimeType      String   @map("mime_type")
  fileSize      BigInt   @map("file_size")
  checksum      String
  extractedText String   @map("extracted_text") @db.LongText
  themeProfile  String   @map("theme_profile") @db.LongText
  dominantTheme String   @map("dominant_theme") @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  uploader      User     @relation("ReferenceUploadedBy", fields: [uploadedBy], references: [id], map: "reference_documents_uploaded_by_fkey")

  @@index([uploadedBy])
  @@map("reference_documents")
}

model SimilarityReport {
  id                  BigInt         @id @default(autoincrement())
  documentId          BigInt         @map("document_id")
  globalSimilarity    Decimal        @map("global_similarity") @db.Decimal(5, 2)
  cosineScore         Decimal?       @map("cosine_score") @db.Decimal(5, 4)
  jaccardScore        Decimal?       @map("jaccard_score") @db.Decimal(5, 4)
  ngramScore          Decimal?       @map("ngram_score") @db.Decimal(5, 4)
  winnowingScore      Decimal?       @map("winnowing_score") @db.Decimal(5, 4)
  lcsScore            Decimal?       @map("lcs_score") @db.Decimal(5, 4)
  styleScore          Decimal?       @map("style_score") @db.Decimal(5, 4)
  simhashScore        Decimal?       @map("simhash_score") @db.Decimal(5, 4)
  semanticScore       Decimal?       @map("semantic_score") @db.Decimal(5, 4)
  aiScore             Decimal?       @map("ai_score") @db.Decimal(5, 2)
  plagiarismScore     Decimal?       @map("plagiarism_score") @db.Decimal(5, 2)
  combinedScore       Decimal?       @map("combined_score") @db.Decimal(5, 2)
  flagged             Boolean        @default(false)
  riskLevel           RiskLevel      @map("risk_level")
  matchedSources      String         @map("matched_sources") @db.LongText
  highlightedSegments String         @map("highlighted_segments") @db.LongText
  analyzedAt          DateTime       @map("analyzed_at")
  generatedBy         BigInt?        @map("generated_by")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")
  document            Document       @relation(fields: [documentId], references: [id], map: "similarity_reports_document_id_fkey")
  generatorUser       User?          @relation(fields: [generatedBy], references: [id], map: "similarity_reports_generated_by_fkey")
  deliberations       Deliberation[]

  @@index([documentId])
  @@index([generatedBy], map: "similarity_reports_generated_by_user_fkey")
  @@map("similarity_reports")
}

model Deliberation {
  id                 BigInt           @id @default(autoincrement())
  similarityReportId BigInt           @map("similarity_report_id")
  decidedBy          BigInt           @map("decided_by")
  committee          String?          @map("committee") @db.VarChar(255)
  decision           String           @map("decision") @db.VarChar(50)
  notes              String?          @map("notes") @db.Text
  decidedAt          DateTime         @map("decided_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  report             SimilarityReport @relation(fields: [similarityReportId], references: [id], map: "deliberations_report_id_fkey")
  decider            User             @relation(fields: [decidedBy], references: [id], map: "deliberations_decided_by_fkey")

  @@index([similarityReportId])
  @@index([decidedBy])
  @@map("deliberations")
}

model AnalysisHistory {
  id              BigInt   @id @default(autoincrement())
  studentId       BigInt   @map("student_id")
  documentId      BigInt?  @map("document_id")
  reportId        BigInt?  @map("report_id")
  fileName        String   @map("file_name") @db.VarChar(512)
  detectedTitle   String?  @map("detected_title") @db.VarChar(512)
  titleScore      Int      @default(0) @map("title_score")
  similarityScore Decimal? @map("similarity_score") @db.Decimal(5, 2)
  blocked         Boolean  @default(false)
  titleMismatch   Boolean  @default(false) @map("title_mismatch")
  attemptNumber   Int      @default(1) @map("attempt_number")
  analyzedAt      DateTime @default(now()) @map("analyzed_at")
  student         User     @relation(fields: [studentId], references: [id], map: "analysis_history_student_id_fkey")

  @@index([studentId])
  @@map("analysis_history")
}

enum Role {
  STUDENT
  TEACHER
  DA
  ADMIN
}

enum ThemeStatus {
  PENDING
  PENDING_VALIDATION
  VALIDATED
  REJECTED
}

enum DocumentStatus {
  SUBMITTED
  ANALYSIS_IN_PROGRESS
  ANALYSIS_COMPLETE
  CLEAN
  FLAGGED_PLAGIARISM
  APPROVED
  APPROVED_WITH_MENTION
  CONDITIONAL_APPROVAL
  REQUESTED_REVIEW
  REJECTED
  FAILED
}

enum AppreciationDecision {
  APPROVED
  APPROVED_WITH_MENTION
  CONDITIONAL_APPROVAL
  REQUESTED_REVIEW
  REJECTED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum AnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
